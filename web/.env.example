# Copy to web/.env.local

SERVICE_URL=http://127.0.0.1:8000
# Same value as the service's SERVICE_SIGNING_SECRET
SERVICE_SIGNING_SECRET=

# The whole site asks for this code. Use a long random one, for example: openssl rand -base64 18
# Without it a development server is open, and a production build lets nobody in.
SITE_ACCESS_CODE=

# Uploads stay off unless both are set. When they are on, also name the bucket's address so the
# browser is allowed to send files there, for example:
# UPLOAD_ORIGIN=https://my-bucket.s3.amazonaws.com https://my-bucket.s3.us-east-1.amazonaws.com
# Anything but "true" hides the upload page and its links. The links are decided at build time.
UPLOADS_ENABLED=false
UPLOAD_ACCESS_CODE=
