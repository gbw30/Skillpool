# Copy to service/.env and run commands with:  uv run --env-file .env <command>

ANTHROPIC_API_KEY=

# Optional, for local runs: keep each document's extraction in this folder, so repeating an
# ingest or an evaluation makes no second Claude call for a document it has already read.
# EXTRACT_CACHE_DIR=.cache/extract

# Embeddings: "voyage" (voyage-4-lite, the default) or "openai" (text-embedding-3-small). Only the chosen
# provider's key is needed. After changing this on a database that already holds documents,
# run:  uv run --env-file .env skillpool reembed
EMBED_PROVIDER=voyage
# Voyage keys are now made in MongoDB Atlas (they start with "al-"); older keys from voyageai.com work too.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Local database from docker-compose.yml. For AuraDB use neo4j+s://<id>.databases.neo4j.io
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=skillpool-dev

# Shared with the web app. Generate with: openssl rand -hex 32
SERVICE_SIGNING_SECRET=

# Only needed for browser uploads. The bucket must accept POST policy uploads (AWS S3 does).
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=

# DAILY_MODEL_BUDGET_USD=5
# SEARCH_RATE_PER_MIN=20
# SEARCH_RATE_PER_DAY=20

# Where documents loaded with ingest-dir can be read. "Open source" links there for them.
# SOURCE_BASE_URL=https://github.com/<owner>/<repo>/blob/main/corpus
